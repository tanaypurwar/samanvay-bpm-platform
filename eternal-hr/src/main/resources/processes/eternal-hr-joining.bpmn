<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_EternalHrJoining" targetNamespace="http://eternalhr.com/bpmn" exporter="Eternal HR" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_EternalHr">
    <bpmn:participant id="Participant_Joining" name="Eternal HR: Joining &amp; documentation" processRef="eternal-hr-joining" />
  </bpmn:collaboration>
  <bpmn:message id="Message_JoiningFormSubmitted" name="JoiningFormSubmitted" />
  <bpmn:process id="eternal-hr-joining" name="Employee joining &amp; documentation" isExecutable="true" camunda:candidateStarterGroups="territory-managers" camunda:historyTimeToLive="P180D" camunda:versionTag="1.0">
    <bpmn:documentation>Raise a new joining request: approval by reporting manager, country head and project manager, then joining form, HRMS record, induction, appointment letter and document verification.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Roles">
      <bpmn:lane id="Lane_TM" name="Territory Manager">
        <bpmn:flowNodeRef>StartEvent_JoiningRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SendBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TmRevise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RM" name="Reporting Manager">
        <bpmn:flowNodeRef>Task_RmReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RmDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CH" name="Country Head">
        <bpmn:flowNodeRef>Task_ChApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ChDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PM" name="Project Manager">
        <bpmn:flowNodeRef>Task_PmApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PmDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LetterReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LetterDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR Team">
        <bpmn:flowNodeRef>Task_HrStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Induction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LetterPrepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LetterRevise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DocsCollect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DocsReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocsOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DocsFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DataVerify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="Eternal HR system">
        <bpmn:flowNodeRef>Gateway_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFormLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitJoiningForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_FormReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFormReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReminderSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HrmsCreate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LetterToPm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LetterToEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalatePm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Escalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HrmsVerify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Onboarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_JoiningRequest" name="Joining request raised" camunda:formKey="samanvay:deployment:forms/joining-request.form.json">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RmReview" name="Review joining: ${candidateName}" camunda:formKey="samanvay:deployment:forms/rm-review.form.json" camunda:candidateGroups="reporting-managers" camunda:dueDate="${dateTime().plusDays(2).toDate()}">
      <bpmn:extensionElements><camunda:taskListener event="complete" expression="${execution.setVariable('reportingManager', task.assignee)}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:incoming>Flow_Resubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRmDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RmDecision" name="Reporting manager decision" default="Flow_RmForward">
      <bpmn:incoming>Flow_ToRmDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_RmForward</bpmn:outgoing>
      <bpmn:outgoing>Flow_RmSendBack</bpmn:outgoing>
      <bpmn:outgoing>Flow_RmReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ChApproval" name="Approve joining (Country Head): ${candidateName}" camunda:formKey="samanvay:deployment:forms/ch-approval.form.json" camunda:candidateGroups="country-heads" camunda:dueDate="${dateTime().plusDays(2).toDate()}">
      <bpmn:extensionElements><camunda:taskListener event="complete" expression="${execution.setVariable('countryHead', task.assignee)}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_RmForward</bpmn:incoming>
      <bpmn:outgoing>Flow_ToChDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ChDecision" name="Country head decision" default="Flow_ChApprove">
      <bpmn:incoming>Flow_ToChDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ChApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChSendBack</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PmApproval" name="Approve joining (PM): ${candidateName}" camunda:formKey="samanvay:deployment:forms/pm-approval.form.json" camunda:candidateGroups="project-managers" camunda:dueDate="${dateTime().plusDays(2).toDate()}">
      <bpmn:extensionElements><camunda:taskListener event="complete" expression="${execution.setVariable('projectManager', task.assignee)}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ChApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPmDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PmDecision" name="Project manager decision" default="Flow_PmApprove">
      <bpmn:incoming>Flow_ToPmDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_PmApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_PmSendBack</bpmn:outgoing>
      <bpmn:outgoing>Flow_PmReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_SendBack" name="Sent back">
      <bpmn:incoming>Flow_RmSendBack</bpmn:incoming>
      <bpmn:incoming>Flow_ChSendBack</bpmn:incoming>
      <bpmn:incoming>Flow_PmSendBack</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRevise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_TmRevise" name="Update joining request: ${candidateName}" camunda:formKey="samanvay:deployment:forms/tm-revise.form.json" camunda:assignee="${initiator}">
      <bpmn:extensionElements><camunda:taskListener event="complete" expression="${execution.removeVariable('rmDecision')}" /><camunda:taskListener event="complete" expression="${execution.removeVariable('chDecision')}" /><camunda:taskListener event="complete" expression="${execution.removeVariable('pmDecision')}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRevise</bpmn:incoming>
      <bpmn:outgoing>Flow_Resubmit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Rejected" name="Rejected">
      <bpmn:incoming>Flow_RmReject</bpmn:incoming>
      <bpmn:incoming>Flow_ChReject</bpmn:incoming>
      <bpmn:incoming>Flow_PmReject</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyRejected" name="Notify initiator of rejection" camunda:type="external" camunda:topic="ehr.notify.joining-rejected">
      <bpmn:incoming>Flow_ToNotifyRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Rejected" name="Joining rejected">
      <bpmn:incoming>Flow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_HrStart" name="Start joining formalities: ${candidateName}" camunda:formKey="samanvay:deployment:forms/hr-start.form.json" camunda:candidateGroups="hr-team">
      <bpmn:incoming>Flow_PmApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendLink</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendFormLink" name="Email joining form link" camunda:type="external" camunda:topic="ehr.joining-form.send-link">
      <bpmn:incoming>Flow_ToSendLink</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWaitForm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Task_WaitJoiningForm" name="Wait for employee joining form" messageRef="Message_JoiningFormSubmitted">
      <bpmn:incoming>Flow_ToWaitForm</bpmn:incoming>
      <bpmn:outgoing>Flow_FormSubmitted</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Timer_FormReminder" name="Reminder due" cancelActivity="false" attachedToRef="Task_WaitJoiningForm">
      <bpmn:outgoing>Flow_ToReminder</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">${joiningFormReminderCycle}</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_SendFormReminder" name="Email joining form reminder" camunda:type="external" camunda:topic="ehr.joining-form.send-reminder">
      <bpmn:incoming>Flow_ToReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReminderEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ReminderSent" name="Reminder sent">
      <bpmn:incoming>Flow_ToReminderEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_HrmsCreate" name="Create employee record in HRMS" camunda:type="external" camunda:topic="ehr.hrms.create-employee">
      <bpmn:incoming>Flow_FormSubmitted</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSplit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Split">
      <bpmn:incoming>Flow_ToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInduction</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToLetterPrepare</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Induction" name="Conduct induction: ${candidateName}" camunda:formKey="samanvay:deployment:forms/induction.form.json" camunda:candidateGroups="hr-team">
      <bpmn:incoming>Flow_ToInduction</bpmn:incoming>
      <bpmn:outgoing>Flow_InductionDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LetterPrepare" name="Prepare appointment letter: ${candidateName}" camunda:formKey="samanvay:deployment:forms/letter-prepare.form.json" camunda:candidateGroups="hr-team">
      <bpmn:incoming>Flow_ToLetterPrepare</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLetterToPm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_LetterToPm" name="Email letter to PM for approval" camunda:type="external" camunda:topic="ehr.letter.send-for-approval">
      <bpmn:incoming>Flow_ToLetterToPm</bpmn:incoming>
      <bpmn:incoming>Flow_LetterResend</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLetterReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_LetterReview" name="Review appointment letter: ${candidateName}" camunda:formKey="samanvay:deployment:forms/letter-review.form.json" camunda:assignee="${projectManager}" camunda:dueDate="${dateTime().plusDays(2).toDate()}">
      <bpmn:incoming>Flow_ToLetterReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLetterDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_LetterDecision" name="Letter approved?" default="Flow_LetterApproved">
      <bpmn:incoming>Flow_ToLetterDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_LetterApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_LetterChanges</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_LetterRevise" name="Revise appointment letter: ${candidateName}" camunda:formKey="samanvay:deployment:forms/letter-revise.form.json" camunda:candidateGroups="hr-team">
      <bpmn:extensionElements><camunda:taskListener event="complete" expression="${execution.removeVariable('letterDecision')}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_LetterChanges</bpmn:incoming>
      <bpmn:outgoing>Flow_LetterResend</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_LetterToEmployee" name="Email appointment letter to employee" camunda:type="external" camunda:topic="ehr.letter.send-to-employee">
      <bpmn:incoming>Flow_LetterApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDocsCollect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_DocsCollect" name="Collect employee documents: ${candidateName}" camunda:formKey="samanvay:deployment:forms/documents-collect.form.json" camunda:candidateGroups="hr-team">
      <bpmn:incoming>Flow_ToDocsCollect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDocsReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_DocsReview" name="Review documents: ${candidateName}" camunda:formKey="samanvay:deployment:forms/documents-review.form.json" camunda:candidateGroups="hr-team">
      <bpmn:incoming>Flow_ToDocsReview</bpmn:incoming>
      <bpmn:incoming>Flow_ReReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDocsOk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DocsOk" name="Documents in order?" default="Flow_DocsIssues">
      <bpmn:incoming>Flow_ToDocsOk</bpmn:incoming>
      <bpmn:outgoing>Flow_DocsOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_DocsIssues</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RequestCorrection" name="Email employee about document issues" camunda:type="external" camunda:topic="ehr.documents.request-correction">
      <bpmn:incoming>Flow_DocsIssues</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFollowUp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_DocsFollowUp" name="Follow up on documents: ${candidateName}" camunda:formKey="samanvay:deployment:forms/documents-follow-up.form.json" camunda:candidateGroups="hr-team">
      <bpmn:extensionElements><camunda:taskListener event="complete" expression="${execution.removeVariable('documentsClear')}" /><camunda:taskListener event="complete" expression="${execution.removeVariable('documentsMatchData')}" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_ReReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_Escalate" name="No response" cancelActivity="false" attachedToRef="Task_DocsFollowUp">
      <bpmn:outgoing>Flow_ToEscalate</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${documentEscalationAfter}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_EscalatePm" name="Escalate missing documents to PM" camunda:type="external" camunda:topic="ehr.documents.escalate">
      <bpmn:incoming>Flow_ToEscalate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEscalatedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Escalated" name="Escalated">
      <bpmn:incoming>Flow_ToEscalatedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_DataVerify" name="Correct and verify employee data: ${candidateName}" camunda:formKey="samanvay:deployment:forms/data-verification.form.json" camunda:candidateGroups="hr-team">
      <bpmn:incoming>Flow_DocsOk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHrmsVerify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_HrmsVerify" name="Mark employee verified in HRMS" camunda:type="external" camunda:topic="ehr.hrms.mark-verified">
      <bpmn:incoming>Flow_ToHrmsVerify</bpmn:incoming>
      <bpmn:outgoing>Flow_DocumentsDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Join">
      <bpmn:incoming>Flow_InductionDone</bpmn:incoming>
      <bpmn:incoming>Flow_DocumentsDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyCompleted</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_NotifyCompleted" name="Notify joining completed" camunda:type="external" camunda:topic="ehr.notify.joining-completed">
      <bpmn:incoming>Flow_ToNotifyCompleted</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndOnboarded</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Onboarded" name="Employee onboarded">
      <bpmn:incoming>Flow_ToEndOnboarded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_JoiningRequest" targetRef="Task_RmReview" />
    <bpmn:sequenceFlow id="Flow_ToRmDecision" sourceRef="Task_RmReview" targetRef="Gateway_RmDecision" />
    <bpmn:sequenceFlow id="Flow_RmForward" name="Forward" sourceRef="Gateway_RmDecision" targetRef="Task_ChApproval" />
    <bpmn:sequenceFlow id="Flow_RmSendBack" name="Send back" sourceRef="Gateway_RmDecision" targetRef="Gateway_SendBack">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rmDecision == 'sendBack'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RmReject" name="Reject" sourceRef="Gateway_RmDecision" targetRef="Gateway_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rmDecision == 'reject'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToChDecision" sourceRef="Task_ChApproval" targetRef="Gateway_ChDecision" />
    <bpmn:sequenceFlow id="Flow_ChApprove" name="Approve" sourceRef="Gateway_ChDecision" targetRef="Task_PmApproval" />
    <bpmn:sequenceFlow id="Flow_ChSendBack" name="Send back" sourceRef="Gateway_ChDecision" targetRef="Gateway_SendBack">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${chDecision == 'sendBack'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ChReject" name="Reject" sourceRef="Gateway_ChDecision" targetRef="Gateway_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${chDecision == 'reject'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToPmDecision" sourceRef="Task_PmApproval" targetRef="Gateway_PmDecision" />
    <bpmn:sequenceFlow id="Flow_PmApprove" name="Approve" sourceRef="Gateway_PmDecision" targetRef="Task_HrStart" />
    <bpmn:sequenceFlow id="Flow_PmSendBack" name="Send back" sourceRef="Gateway_PmDecision" targetRef="Gateway_SendBack">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pmDecision == 'sendBack'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PmReject" name="Reject" sourceRef="Gateway_PmDecision" targetRef="Gateway_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pmDecision == 'reject'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToRevise" sourceRef="Gateway_SendBack" targetRef="Task_TmRevise" />
    <bpmn:sequenceFlow id="Flow_Resubmit" name="Resubmit" sourceRef="Task_TmRevise" targetRef="Task_RmReview" />
    <bpmn:sequenceFlow id="Flow_ToNotifyRejected" sourceRef="Gateway_Rejected" targetRef="Task_NotifyRejected" />
    <bpmn:sequenceFlow id="Flow_ToEndRejected" sourceRef="Task_NotifyRejected" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_ToSendLink" sourceRef="Task_HrStart" targetRef="Task_SendFormLink" />
    <bpmn:sequenceFlow id="Flow_ToWaitForm" sourceRef="Task_SendFormLink" targetRef="Task_WaitJoiningForm" />
    <bpmn:sequenceFlow id="Flow_ToReminder" sourceRef="Timer_FormReminder" targetRef="Task_SendFormReminder" />
    <bpmn:sequenceFlow id="Flow_ToReminderEnd" sourceRef="Task_SendFormReminder" targetRef="EndEvent_ReminderSent" />
    <bpmn:sequenceFlow id="Flow_FormSubmitted" name="Form submitted" sourceRef="Task_WaitJoiningForm" targetRef="Task_HrmsCreate" />
    <bpmn:sequenceFlow id="Flow_ToSplit" sourceRef="Task_HrmsCreate" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_ToInduction" sourceRef="Gateway_Split" targetRef="Task_Induction" />
    <bpmn:sequenceFlow id="Flow_ToLetterPrepare" sourceRef="Gateway_Split" targetRef="Task_LetterPrepare" />
    <bpmn:sequenceFlow id="Flow_InductionDone" sourceRef="Task_Induction" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ToLetterToPm" sourceRef="Task_LetterPrepare" targetRef="Task_LetterToPm" />
    <bpmn:sequenceFlow id="Flow_ToLetterReview" sourceRef="Task_LetterToPm" targetRef="Task_LetterReview" />
    <bpmn:sequenceFlow id="Flow_ToLetterDecision" sourceRef="Task_LetterReview" targetRef="Gateway_LetterDecision" />
    <bpmn:sequenceFlow id="Flow_LetterApproved" name="Approved" sourceRef="Gateway_LetterDecision" targetRef="Task_LetterToEmployee" />
    <bpmn:sequenceFlow id="Flow_LetterChanges" name="Changes needed" sourceRef="Gateway_LetterDecision" targetRef="Task_LetterRevise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${letterDecision == 'changes'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LetterResend" sourceRef="Task_LetterRevise" targetRef="Task_LetterToPm" />
    <bpmn:sequenceFlow id="Flow_ToDocsCollect" sourceRef="Task_LetterToEmployee" targetRef="Task_DocsCollect" />
    <bpmn:sequenceFlow id="Flow_ToDocsReview" sourceRef="Task_DocsCollect" targetRef="Task_DocsReview" />
    <bpmn:sequenceFlow id="Flow_ToDocsOk" sourceRef="Task_DocsReview" targetRef="Gateway_DocsOk" />
    <bpmn:sequenceFlow id="Flow_DocsOk" name="In order" sourceRef="Gateway_DocsOk" targetRef="Task_DataVerify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentsClear &amp;&amp; documentsMatchData}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DocsIssues" name="Issues found" sourceRef="Gateway_DocsOk" targetRef="Task_RequestCorrection" />
    <bpmn:sequenceFlow id="Flow_ToFollowUp" sourceRef="Task_RequestCorrection" targetRef="Task_DocsFollowUp" />
    <bpmn:sequenceFlow id="Flow_ReReview" name="Documents received" sourceRef="Task_DocsFollowUp" targetRef="Task_DocsReview" />
    <bpmn:sequenceFlow id="Flow_ToEscalate" sourceRef="Timer_Escalate" targetRef="Task_EscalatePm" />
    <bpmn:sequenceFlow id="Flow_ToEscalatedEnd" sourceRef="Task_EscalatePm" targetRef="EndEvent_Escalated" />
    <bpmn:sequenceFlow id="Flow_ToHrmsVerify" sourceRef="Task_DataVerify" targetRef="Task_HrmsVerify" />
    <bpmn:sequenceFlow id="Flow_DocumentsDone" sourceRef="Task_HrmsVerify" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ToNotifyCompleted" sourceRef="Gateway_Join" targetRef="Task_NotifyCompleted" />
    <bpmn:sequenceFlow id="Flow_ToEndOnboarded" sourceRef="Task_NotifyCompleted" targetRef="EndEvent_Onboarded" />
  </bpmn:process>
