# TLS certificates come from Let's Encrypt automatically and are kept in the caddy-data volume.
{$SAMANVAY_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Deploying from anywhere (Camunda Modeler, curl). The engine still requires HTTP Basic auth.
	@engineDeploy {
		method POST
		path /engine-rest/deployment/create
	}
	handle @engineDeploy {
		reverse_proxy engine:8080
	}
	@engineDeployInfo {
		method GET
		path /engine-rest/version /engine-rest/deployment
	}
	handle @engineDeployInfo {
		reverse_proxy engine:8080
	}

	# the rest of the engine REST API is for the tasklist backend only
	@engineRest path /engine-rest /engine-rest/*
	handle @engineRest {
		respond 404
	}

	# routes of process applications deployed next to the platform (see apps/)
	import /etc/caddy/apps/*.caddy

	# engine webapps: Cockpit, Admin, Tasklist
	redir /camunda /camunda/app/ 302
	handle /camunda/* {
		reverse_proxy engine:8080
	}

	# Samanvay Tasklist: React app, /api (web and mobile)
	handle {
		reverse_proxy tasklist:8081
	}
}
